{
  "name": "fya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "db:types": "node scripts/generate-database-types.mjs && prettier --write lib/supabase/database.types.ts",
    "format": "prettier --write app components lib scripts tests proxy.ts",
    "local:start": "supabase start --network-id fya-local",
    "local:env": "node scripts/local-env.mjs",
    "local:seed": "node scripts/seed-local.mjs",
    "local:stop": "supabase stop",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "trello:worker": "node --env-file=.env.local scripts/trello-worker.mjs",
    "trello:admin": "node --env-file=.env.local scripts/trello-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "^16.3.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
